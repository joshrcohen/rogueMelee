# Track only the mod overlay and its tooling; everything else is local/cache.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/mod/
!/patches/
!/tools/
!/tests/
!/.github/
/tools/*
!/tools/build.py
!/tools/package/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/build.yml
__pycache__/
*.pyc
*.exe
*.dll
*.iso
*.gcm
*.rvz
*.raw
*.gci
*.dol
*.elf
*.zip
*.delta
*.log
!/Make Update Package.bat
